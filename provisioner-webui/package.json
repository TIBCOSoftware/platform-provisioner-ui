{
  "name": "provisioner-webui",
  "version": "3.4.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "shx rm -rf ./dist/client && run-p type-check \"build-only {@}\" --",
    "inspect": "cross-env NODE_OPTIONS=--max-http-header-size=16384 node --inspect=0.0.0.0:9229 server/app.js 2>&1",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build tsconfig.app.json --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "watch-build": "chokidar \"src/**/*\" \"index.html\" -c \"npm run build:client:dev\"",
    "watch-build:no-hash": "cross-env NO_HASH=true chokidar \"src/**/*\" \"index.html\" -c \"npm run build:client:dev\"",
    "build:client": "npm run build",
    "build:client:prod": "npm run build",
    "build:client:dev": "vite build --mode development",
    "build:prod": "npm run build:client:prod && npm run build:server",
    "build:dev": "npm run build:client:dev && npm run build:server",
    "build:server": "shx rm -rf ./dist/server && shx cp -rf ./server ./dist/server",
    "start": "node server/app.js",
    "start:dev": "cross-env NODE_OPTIONS=--max-http-header-size=16384 node --inspect=0.0.0.0:9229 server/app.js 2>&1",
    "start:local": "npm run build:dev && npm run _start:local:server",
    "start:local:dev": "cross-env DEV_IS_WATCH_CODE=true npm run _start:local:server",
    "_start:local:server": "cross-env ON_PREM_MODE=true DEV_START_FROM_SOURCE=true NODE_ENV=development PIPELINES_CLEAN_UP_ENABLED=true node --trace-warnings server/app.js",
    "test:unit": "vitest run --reporter=verbose --reporter=html --outputFile.html=test-results/unit-ui/index.html && vitest run --config vitest.server.config.ts --reporter=verbose --reporter=html --outputFile.html=test-results/unit-server/index.html",
    "test:unit:ui": "vitest run",
    "test:unit:server": "vitest run --config vitest.server.config.ts",
    "test:e2e": "npx playwright test --reporter=list,html",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@kubernetes/client-node": "1.1.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@node-saml/passport-saml": "5.1.0",
    "@primevue/themes": "4.0.7",
    "@vuelidate/core": "2.0.3",
    "@vuelidate/validators": "2.0.4",
    "@wdns/vue-code-block": "2.3.3",
    "ace-builds": "1.36.2",
    "axios": "1.13.6",
    "bootstrap-icons": "1.11.3",
    "dayjs": "1.11.20",
    "dayjs-plugin-utc": "0.1.2",
    "diff": "7.0.0",
    "dompurify": "3.3.3",
    "highlight.js": "11.11.1",
    "js-yaml": "4.1.1",
    "json-editor-vue3": "1.1.1",
    "jsonwebtoken": "9.0.3",
    "koa": "2.16.4",
    "koa-body": "6.0.1",
    "koa-compress": "5.1.1",
    "koa-conditional-get": "3.0.0",
    "koa-etag": "4.0.0",
    "koa-json": "2.0.2",
    "koa-passport": "6.0.0",
    "koa-router": "13.0.1",
    "koa-session": "6.4.0",
    "koa-static": "5.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "lodash": "4.17.23",
    "markdown-it": "14.1.1",
    "nconf": "0.12.1",
    "pinia": "2.2.2",
    "primeicons": "7.0.0",
    "primevue": "4.0.7",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "semver": "7.7.4",
    "sha256-es": "1.8.2",
    "swagger-jsdoc": "^6.2.8",
    "vue": "3.5.30",
    "vue-json-pretty": "2.6.0",
    "vue-router": "4.4.5",
    "vue3-toastify": "0.2.9",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "9.11.1",
    "@playwright/test": "1.58.2",
    "@rushstack/eslint-patch": "1.16.1",
    "@tsconfig/node20": "20.1.9",
    "@types/diff": "7.0.2",
    "@types/dompurify": "3.0.5",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "21.1.7",
    "@types/lodash": "4.17.24",
    "@types/markdown-it": "14.1.2",
    "@types/node": "20.14.5",
    "@types/prismjs": "1.26.6",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vitest/ui": "3.2.4",
    "@vue/eslint-config-prettier": "9.0.0",
    "@vue/eslint-config-typescript": "13.0.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.5.1",
    "chokidar-cli": "3.0.0",
    "cross-env": "10.1.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-playwright": "1.6.2",
    "eslint-plugin-vue": "9.28.0",
    "jsdom": "24.1.0",
    "less": "4.6.3",
    "npm-run-all2": "6.2.3",
    "prettier": "3.8.1",
    "sass": "1.98.0",
    "shx": "0.4.0",
    "typescript": "5.6.2",
    "vite": "6.4.1",
    "vite-plugin-vue-devtools": "8.1.1",
    "vitest": "3.2.4",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "2.1.6"
  }
}
